# Copy this file to .env and fill in the blanks. Never commit .env.

# Database. "db" is the docker-compose service name.
# If you run Python outside Docker, use localhost:5432 (or your hosted Postgres URL).
DATABASE_URL=postgresql+psycopg://invoice:invoice@db:5432/invoice

# LLM. Tests never use these.
# LLM_PROVIDER picks which AI service extracts the fields: gemini | anthropic
LLM_PROVIDER=gemini
# Gemini key: aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude key (only if LLM_PROVIDER=anthropic): console.anthropic.com
ANTHROPIC_API_KEY=
# Model name for the chosen provider (filled in during M2)
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=8000

# File storage
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Long random string used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Where the Streamlit UI finds the API
API_BASE_URL=http://api:8000

# Tesseract path. Inside Docker this is correct.
# On Windows without Docker: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
